rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signaux hebdomadaires : lecture libre (donnée de marché publique),
    // écriture impossible depuis le client. Seul le cron (service account
    // admin, qui contourne ces règles) écrit dans cette collection.
    match /signals/{weekId} {
      allow read: if true;
      allow write: if false;
    }

    // Données utilisateur : profil, réglages, supports, versements.
    // Lecture et écriture réservées au propriétaire authentifié.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
